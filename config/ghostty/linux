# Keep Omarchy's dynamic theme, font integration, key encoding, and Hyprland
# compatibility fixes as the updateable base layer.
config-file = ?"/usr/share/omarchy/config/ghostty/config"

# Keep personal values in a separate include. Omarchy's global text-size tool
# edits only this top-level file, so it cannot replace the terminal-only size.
config-file = ?"~/.config/ghostty/dotfiles.conf"
